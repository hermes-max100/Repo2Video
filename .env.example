# ELEVENLABS_API_KEY: Required for ElevenLabs ultra-realistic AI voiceover generation.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
ELEVENLABS_API_KEY=MY_ELEVENLABS_API_KEY
ELEVEN_LABS_API_KEY=MY_ELEVENLABS_API_KEY
XI_API_KEY=MY_XI_API_KEY

# XAI_API_KEY / GROK: For xAI Grok model access with SuperGrok
XAI_API_KEY=MY_XAI_API_KEY
GROK_API_KEY=MY_GROK_API_KEY
SUPERGROK_ACCESS_TOKEN=MY_SUPERGROK_ACCESS_TOKEN

